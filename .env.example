# =============================================================================
# BLACKGATE — local / Vercel
# Copy to `.env` and `.env.local` (Prisma reads `.env`; Next.js reads `.env.local`)
# =============================================================================

# SQLite for local. Switch to the shared Supabase pooler for production.
DATABASE_URL="file:./dev.db"

# NextAuth — production URL e.g. https://gate.blacklinepa.com
NEXTAUTH_URL="http://localhost:3002"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Local document store
UPLOAD_DIR="public/uploads"

# ---------------------------------------------------------------------------
# Sibling integrations (optional — dry-run when unset)
# ---------------------------------------------------------------------------

# BLACKBOX claim creation. When unset, promote records a dry-run handoff.
BLACKBOX_API_URL="http://localhost:3000"
BLACKBOX_API_KEY=
# Set to 1 to always simulate a successful promote (local demo)
BLACKBOX_DRY_RUN=1

# BLACKMIRROR field-task creation for missing damage photos / site evidence
BLACKMIRROR_API_URL="http://localhost:3001"
BLACKMIRROR_API_KEY=

# BLACKLEDGER tag for fee-bearing referrals (attorney / partner splits)
BLACKLEDGER_API_URL="http://localhost:3003"
BLACKLEDGER_API_KEY="dev-ledger-key"

# ---------------------------------------------------------------------------
# Inbound referral webhooks (ClaimSaver+ / thePolicyLine / generic partners)
# ---------------------------------------------------------------------------

CLAIMSAVER_WEBHOOK_SECRET="dev-claimsaver-secret"
POLICYLINE_WEBHOOK_SECRET="dev-policyline-secret"
PARTNER_WEBHOOK_SECRET="dev-partner-secret"

# Seed is destructive — never run against production without this flag
# ALLOW_DESTRUCTIVE_SEED=1
